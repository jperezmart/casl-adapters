{
  "name": "@jperezmart/casl-react",
  "version": "0.1.0",
  "description": "The browser side of the jperezmart CASL Adapters: a React provider that builds the Client ability from a Rules endpoint, a typed Can and hooks, and a TanStack Query integration.",
  "keywords": [
    "react",
    "casl",
    "authorization",
    "permissions",
    "abilities",
    "tanstack-query"
  ],
  "homepage": "https://github.com/jperezmart/casl-adapters/tree/main/packages/casl-react#readme",
  "bugs": {
    "url": "https://github.com/jperezmart/casl-adapters/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jperezmart/casl-adapters.git",
    "directory": "packages/casl-react"
  },
  "license": "MIT",
  "author": "Javier Pérez Martín <javier.perez.martin97@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tanstack-query": {
      "import": {
        "types": "./dist/tanstack-query.d.ts",
        "default": "./dist/tanstack-query.js"
      },
      "require": {
        "types": "./dist/tanstack-query.d.cts",
        "default": "./dist/tanstack-query.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@casl/ability": "catalog:",
    "@casl/react": "catalog:",
    "@jperezmart/casl-core": "workspace:*",
    "@jperezmart/eslint-config": "catalog:",
    "@jperezmart/typescript-config": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@casl/ability": "^7.0.0",
    "@casl/react": "^7.0.0",
    "@jperezmart/casl-core": "workspace:^",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
