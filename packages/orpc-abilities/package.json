{
  "name": "@jperezmart/orpc-abilities",
  "version": "0.0.0",
  "private": true,
  "description": "CASL abilities for the oRPC example: kind-tagged subjects, AppAbility and detectSubjectType (client-safe), plus the Role permissions under ./server. Depends only on @jperezmart/orpc-domain and @casl/ability.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@casl/ability": "catalog:",
    "@jperezmart/orpc-domain": "workspace:*"
  },
  "devDependencies": {
    "@jperezmart/eslint-config": "catalog:",
    "@jperezmart/typescript-config": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
