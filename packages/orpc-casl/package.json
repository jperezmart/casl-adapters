{
  "name": "@jperezmart/orpc-casl",
  "version": "0.0.0",
  "description": "The oRPC Adapter of @jperezmart/casl-core: a middleware that adds the request's CASL Ability to the procedure context, an assertCan that throws oRPC's errors by the Denial rule, and a ready-made Rules endpoint procedure.",
  "keywords": [
    "orpc",
    "casl",
    "authorization",
    "permissions",
    "abilities",
    "rbac",
    "abac"
  ],
  "homepage": "https://github.com/jperezmart/nest-casl/tree/main/packages/orpc-casl#readme",
  "bugs": {
    "url": "https://github.com/jperezmart/nest-casl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jperezmart/nest-casl.git",
    "directory": "packages/orpc-casl"
  },
  "license": "MIT",
  "author": "Javier Pérez Martín <javier.perez.martin97@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@casl/ability": "catalog:",
    "@jperezmart/casl-core": "workspace:*",
    "@jperezmart/eslint-config": "catalog:",
    "@jperezmart/typescript-config": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@casl/ability": "^7.0.0",
    "@jperezmart/casl-core": "workspace:^",
    "@orpc/server": "^1.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
