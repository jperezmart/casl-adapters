{
  "name": "@jperezmart/next-casl",
  "version": "0.0.0",
  "description": "The Next.js Pages Router Adapter of @jperezmart/casl-core: getServerSideProps and API route wrappers that hand over the request's CASL Ability, an assertCan that answers by the Denial rule, a custom App helper for denied pages and a ready-made Rules endpoint API route.",
  "keywords": [
    "nextjs",
    "next",
    "casl",
    "authorization",
    "permissions",
    "abilities",
    "rbac",
    "abac"
  ],
  "homepage": "https://github.com/jperezmart/nest-casl/tree/main/packages/next-casl#readme",
  "bugs": {
    "url": "https://github.com/jperezmart/nest-casl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jperezmart/nest-casl.git",
    "directory": "packages/next-casl"
  },
  "license": "MIT",
  "author": "Javier Pérez Martín <javier.perez.martin97@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@casl/ability": "catalog:",
    "@jperezmart/casl-core": "workspace:*",
    "@jperezmart/eslint-config": "catalog:",
    "@jperezmart/typescript-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "supertest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@casl/ability": "^7.0.0",
    "@jperezmart/casl-core": "workspace:^",
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
